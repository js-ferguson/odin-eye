    <ItemGroup>
        <Reference Include="mscorlib" />
        <Reference Include="nunit.framework, Version=3.14.0.0, Culture=neutral, PublicKeyToken=2638cd05610744eb, processorArchitecture=MSIL">
          <HintPath>..\..\packages\NUnit.3.14.0\lib\net45\nunit.framework.dll</HintPath>
        </Reference>
        <Reference Include="nunitlite, Version=3.14.0.0, Culture=neutral, PublicKeyToken=2638cd05610744eb, processorArchitecture=MSIL">
          <HintPath>..\..\packages\NUnitLite.3.14.0\lib\net45\nunitlite.dll</HintPath>
        </Reference>
        <!-- OdinEye.Models targets netstandard2.0, which needs a real,
        validly-signed netstandard.dll present at runtime under plain .NET
        Framework (the game process's Mono runtime resolves this without
        one, which is why this was silent locally and in the live BepInEx
        test but not on CI). Two earlier attempts failed: relying on
        implicit/GAC resolution alone (file not found on the CI image), and
        shipping ValheimGameLibs' netstandard.dll (present, but fails
        strong-name validation, likely modified by a BepInEx-adjacent
        publicizing step). This is Microsoft's own, unmodified reference
        assembly instead, paired with the matching bindingRedirect in
        App.config below (its self-identified version is 2.0.0.0, not the
        2.1.0.0 real MSBuild on Windows requests implicitly). -->
        <Reference Include="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51, processorArchitecture=MSIL">
          <HintPath>..\..\packages\Microsoft.NETFramework.ReferenceAssemblies.net481.1.0.3\build\.NETFramework\v4.8.1\Facades\netstandard.dll</HintPath>
          <Private>true</Private>
        </Reference>
        <Reference Include="System" />
        <Reference Include="System.Core" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="CharacterStatsPayloadBuilderTests.cs" />
        <Compile Include="ClientPipelineTests.cs" />
        <Compile Include="CustomCounterStoreTests.cs" />
        <Compile Include="PieceStatsAndPolicyTests.cs" />
        <Compile Include="Program.cs" />
        <Compile Include="Properties\AssemblyInfo.cs" />
        <Compile Include="SubmissionSchedulerTests.cs" />
        <Compile Include="TemporalClockTests.cs" />
    </ItemGroup>
    <ItemGroup>
      <None Include="App.config" />
      <None Include="packages.config" />
    </ItemGroup>
    <ItemGroup>
      <!-- Only the pure/testable classes (Stats/CharacterStatsPayloadBuilder,
      Submission/SubmissionScheduler) are exercised here. Referencing the
      whole OdinEye.Client assembly is still safe even though this test
      project never loads BepInEx/Unity/Valheim: the CLR resolves an
      assembly lazily, only when a type from it is actually touched, and
      these tests never touch OdinEyeClientPlugin, PlayerProfileStatsSource
      or HttpStatsSubmitter. -->
      <ProjectReference Include="..\OdinEye.Client\OdinEye.Client.csproj">
        <Project>{9a2d6f3b-8c1e-4f5a-b0d7-3e2c1a9b6d4f}</Project>
        <Name>OdinEye.Client</Name>
      </ProjectReference>
      <!-- CharacterStatsPayloadBuilder.Build returns OdinEye.Models.Api.CharacterStatsSubmission,
      so the tests need a direct reference to it too (C# requires this even
      though OdinEye.Client already references it transitively). -->
      <ProjectReference Include="..\OdinEye.Models\OdinEye.Models.csproj">
        <Project>{0c64b257-49e8-4202-bb95-035170eaf5ec}</Project>
        <Name>OdinEye.Models</Name>
      </ProjectReference>
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
